# WFX Phantom Detector - Environment Configuration
# Copy to .env and fill in your values. NEVER commit the filled .env.

# ===== REQUIRED (startup fails without these) =====
GITHUB_WEBHOOK_SECRET=replace-with-github-app-webhook-secret
API_ALERT_TOKEN=replace-with-a-long-random-admin-token
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# Redis URL for the app (matches docker-compose service name)
REDIS_URL=redis://redis:6379/0

# ===== OPTIONAL: GitHub App credentials (only if adding API-based content fetching) =====
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ===== OPTIONAL: Alerting =====
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ===== Dev-only fallback (NOT for production) =====
# ALLOW_IN_MEMORY=true   # allows volatile storage when Redis is unavailable

# ===== OPTIONAL: Limits =====
# DEDUP_WINDOW=3600            # dedup TTL seconds (default 1 hour)
# MAX_CONTENT_LENGTH=10485760  # max HTTP body bytes (default 10 MiB)
# RATE_LIMIT_MAX=100           # requests per window per client
# RATE_LIMIT_WINDOW=60         # rate-limit window seconds

# ===== OPTIONAL: Logging / server =====
LOG_LEVEL=INFO
# LOG_FORMAT=json
PORT=8080
